<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files/dirs at root directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Serve built assets from dist when the repository root is deployed.
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]
  RewriteRule ^(favicon\.ico|robots\.txt|placeholder\.svg)$ dist/$1 [L]

  # Serve the production app from dist.
  RewriteRule ^$ dist/index.html [L]
  RewriteRule ^.*$ dist/index.html [L]
</IfModule>

<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType text/javascript .mjs
  AddType text/css .css
</IfModule>
