# Ignore everything by default
*

# Keep this file tracked so the rule persists
!.gitignore
!.htaccess

# Keep only deployment output at repository root
!index.html
!404.html
!robots.txt
!favicon.ico
!placeholder.svg
!assets/
!assets/**

# Keep production build output and Apache config tracked for deployment
!dist/
!dist/**
!public/
!public/.htaccess
